<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FSMExpress.ViewModels"
             xmlns:util="using:FSMExpress.Logic.Util"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="FSMExpress.Controls.FsmListPanel"
             x:DataType="vm:FsmListPanelViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="4">
      <TextBox Text="{Binding SearchText}" Watermark="Search FSMs..." />
      
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Search Mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Grid.Row="0" Grid.Column="1" 
                  ItemsSource="{Binding SearchModes}"
                  SelectedItem="{Binding SearchMode}"
                  HorizontalAlignment="Stretch" />
      </Grid>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Entries}" 
              SelectedItem="{Binding SelectedEntry}"
              Margin="4"
              IsReadOnly="True"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              AutoGenerateColumns="False"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="FSM Name" 
                            Binding="{Binding Name}" 
                            Width="*"/>
        <DataGridTextColumn Header="States" 
                            Binding="{Binding StateCount}" 
                            Width="70"/>
        <DataGridTextColumn Header="Transitions" 
                            Binding="{Binding TransitionCount}" 
                            Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>